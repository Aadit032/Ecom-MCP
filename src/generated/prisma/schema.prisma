generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String  @id
  name      String
  email     String
  riskScore Int
  orders    Order[]
}

model Order {
  id              String       @id
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdAt       String
  status          String
  currency        String       @default("USD")
  itemDescription String
  quantity        Int
  payments        Payment[]
  shipments       Shipment[]
  refunds         Refund[]
  escalations     Escalation[]
}

model Payment {
  id             String       @id
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         String
  amountPaid     Decimal      @db.Decimal(12, 2)
  amountRefunded Decimal      @default(0) @db.Decimal(12, 2)
  capturedAt     String
  chargebackFlag Boolean      @default(false)
  disputeFlag    Boolean      @default(false)
  refunds        Refund[]
  escalations    Escalation[]
}

model Shipment {
  id                String  @id
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String
  trackingNumber    String
  status            String
  carrierException  String?
  exceptionVerified Boolean @default(false)
  shippedAt         String?
  deliveredAt       String?
}

model Refund {
  id           String  @id
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId    String
  payment      Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount       Decimal @db.Decimal(12, 2)
  action       String
  reason       String
  status       String
  autoApproved Boolean
  escalationId String?
  createdAt    String

  // Idempotency: one refund per payment + amount
  @@unique([paymentId, amount])
}

model Escalation {
  id                String  @id
  orderId           String
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId         String
  payment           Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedAmount   Decimal @db.Decimal(12, 2)
  action            String
  reason            String
  status            String
  failedChecks      Json
  createdAt         String
  resolvedAt        String?
  resolvedBy        String?
  resolutionNote    String?
  resultingRefundId String?
}

/// Sequential ID counter for ref_/esc_ prefixes
model IdCounter {
  name  String @id
  value Int    @default(1000)
}
